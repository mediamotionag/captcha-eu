<?php
use Symfony\Component\HttpFoundation\Request;
use \Contao\System;

$this->extend('form_row'); ?>

<?php $this->block('field');
?>

<?php
if (!System::getContainer()->get('contao.routing.scope_matcher')->isBackendRequest(System::getContainer()->get('request_stack')->getCurrentRequest() ?? Request::create(''))){
    $request = System::getContainer()->get('request_stack')->getCurrentRequest() ?? Request::create('');
    $checkerId = 'dc-captcha-eu-checker-' . $this->id;
    $bootstrapUrl = $this->route('duncrow_captcha_eu_frontend', ['_locale' => $request->getLocale()]) . '?' . http_build_query([
        'root' => $this->rootPageId,
        'widget' => $this->recaptchaType,
    ]);
    $GLOBALS['TL_JAVASCRIPT'][] = $this->asset('bundles/duncrowgmbhcaptchaeu/captcha-eu-bootstrap.js') . '|static|defer';
?>
    <?php if ($this->hasErrors()){ ?>
        <p class="error"><?= $this->getErrorAsString() ?></p>
    <?php } ?>
    <div id="<?= $checkerId ?>" class="cpt_widget" data-captcha-eu-config-url="<?= $bootstrapUrl ?>"></div>
    <?php } else{
     ?>
<span>Captcha-Eu <br><i><?= $GLOBALS['TL_LANG']['tl_form_field']['howTo'] ?> </i></span>

     <?php
    }
     ?>
<?php $this->endblock(); ?>

